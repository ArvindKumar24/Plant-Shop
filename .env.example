# ==========================================================
# GreenLeaf Plants - Environment Variables (example)
# Copy this file to `.env` and fill in your Supabase values.
# On Vercel, set these SAME variables in:
#   Project -> Settings -> Environment Variables
# ==========================================================

# --- Supabase (PostgreSQL) connection string ---
# Get it from Supabase Dashboard -> Project Settings -> Database.
#
# Two connection options:
#   - Direct connection (local dev / long-lived server):
#       postgresql://postgres.<PROJECT-REF>:<DB-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
#   - Transaction pooler (serverless, e.g. Vercel):
#       postgresql://postgres.<PROJECT-REF>:<DB-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
#
# IMPORTANT:
#   - Replace <PROJECT-REF> (the subdomain of your project URL).
#   - Replace <DB-PASSWORD> with the database password you set when
#     creating the project (or reset it in Project Settings -> Database).
#   - Keep `?sslmode=require` at the end.
DATABASE_URL=

# --- Server (local dev only; ignored on Vercel) ---
# HOST=127.0.0.1
# PORT=8000
